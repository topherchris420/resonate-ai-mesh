{
  "name": "pordenone-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic validation kernel, simulated telemetry, and a 3D research dashboard",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pytest services/ tests/ && cargo test --workspace",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "proto:generate": "bash scripts/generate-proto.sh"
  },
  "devDependencies": {
    "next": "^15.5.27",
    "turbo": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28"
    }
  }
}
