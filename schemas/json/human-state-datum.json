{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resonate-ai-mesh:schema:human-state-datum",
  "title": "HumanStateDatum",
  "description": "One human-state measurement or simulated value. Values are operational indices, not clinical or wellness measurements.",
  "type": "object",
  "required": [
    "metric",
    "value",
    "unit",
    "timestamp",
    "source",
    "mode",
    "confidence",
    "quality"
  ],
  "additionalProperties": false,
  "properties": {
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "e.g. operator_load_index"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "e.g. index[0,1] or bpm"
    },
    "timestamp": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Producing component, e.g. sim.operator_load.v1"
    },
    "mode": {
      "enum": [
        "SIMULATED",
        "LIVE",
        "REPLAY"
      ]
    },
    "original_mode": {
      "enum": [
        "SIMULATED",
        "LIVE",
        null
      ],
      "description": "Required for REPLAY data; must be absent or null otherwise."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The source's own reliability estimate, not a probability that the value is true."
    },
    "quality": {
      "enum": [
        "GOOD",
        "DEGRADED",
        "INVALID",
        "MISSING"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REPLAY"
          }
        }
      },
      "then": {
        "required": [
          "original_mode"
        ],
        "properties": {
          "original_mode": {
            "enum": [
              "SIMULATED",
              "LIVE"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "original_mode": {
            "const": null
          }
        }
      }
    }
  ]
}
