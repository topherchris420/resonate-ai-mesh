{
  "version": "resonate-ai-mesh.experiment-summary.v1",
  "experiment_id": "resonance-routing",
  "title": "Routing judgment by measured agent instability",
  "question": "Can judgment be consulted only for agents whose recent proposals were often not committed, cutting judgment calls while keeping its effect on commits made from degraded evidence?\n",
  "hypothesis": {
    "statement": "Instability routing makes fewer judgment calls than consulting judgment on every valid proposal.\n",
    "prediction": {
      "metric": "judgment_calls",
      "direction": "decrease",
      "baseline": "judge_always",
      "treatment": "judge_on_instability"
    }
  },
