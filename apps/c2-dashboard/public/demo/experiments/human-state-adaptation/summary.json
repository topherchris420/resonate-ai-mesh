  "version": "resonate-ai-mesh.experiment-summary.v1",
  "experiment_id": "human-state-adaptation",
  "title": "Operator-load gating",
  "question": "When the simulated operator-load index reaches HIGH or CRITICAL, does deferring background proposals reduce the commits the operator must absorb, and what does it cost in background progress?\n",
  "hypothesis": {
    "statement": "With gating enabled, fewer proposals are committed while load is high, and the load index itself is coupled to the rate of uncommitted proposals.\n",
    "prediction": {
      "metric": "committed",
      "direction": "decrease",
      "baseline": "gating_off",
      "treatment": "gating_on"
    }
  },
