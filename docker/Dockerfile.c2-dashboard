# The research cockpit. In the browser it talks to mesh serve at
# NEXT_PUBLIC_MESH_URL and falls back to the bundled static export.
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/c2-dashboard ./apps/c2-dashboard
COPY packages/shared-types ./packages/shared-types
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_MESH_URL=http://localhost:7878
ENV NEXT_PUBLIC_MESH_URL=$NEXT_PUBLIC_MESH_URL NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone
RUN pnpm --filter c2-dashboard build

FROM node:22-alpine
WORKDIR /app
COPY --from=build --chown=node:node /src/apps/c2-dashboard/.next/standalone ./
COPY --from=build --chown=node:node /src/apps/c2-dashboard/.next/static ./apps/c2-dashboard/.next/static
COPY --from=build --chown=node:node /src/apps/c2-dashboard/public ./apps/c2-dashboard/public
USER node
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["node", "apps/c2-dashboard/server.js"]
